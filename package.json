{
  "name": "docker-compose-cache-action",
  "version": "1.8.18",
  "description": "Dynamically caches Docker images defined in a docker-compose.yml file using TypeScript.",
  "keywords": [
    "actions",
    "cache",
    "docker",
    "docker-compose",
    "github"
  ],
  "homepage": "https://github.com/seijikohara/docker-compose-cache-action#readme",
  "bugs": {
    "url": "https://github.com/seijikohara/docker-compose-cache-action/issues"
  },
  "license": "MIT",
  "author": "Seiji Kohara <sage.0118@gmail.com> (https://github.com/seijikohara)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seijikohara/docker-compose-cache-action.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "package": "pnpm run build && node scripts/generate-licenses.mjs",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "lefthook install",
    "deps:update": "taze -w && pnpm install",
    "deps:check": "taze"
  },
  "dependencies": {
    "@actions/cache": "^6.0.1",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "date-fns": "^4.1.0",
    "js-yaml": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.25.0",
    "taze": "^19.14.1",
    "tsdown": "^0.22.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.13.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.1"
}
